#!/usr/bin/env bash
# ==============================================================================
# CYBER NOIR WORKSTATION // SWAY LAUNCH WRAPPER (NVIDIA & HYBRID GPU OPTIMIZED)
# ==============================================================================
# Resolves proprietary NVIDIA Wayland incompatibilities and locale fallbacks
# to prevent display manager crash loops and compositor aborts.
# ==============================================================================

# 1. Locale protection against xkbcommon compose file crash (en_IN/unsupported locales)
export LANG="${LANG:-en_US.UTF-8}"
export LC_ALL="${LC_ALL:-en_US.UTF-8}"

# 2. NVIDIA & Hybrid Wayland hardware configuration flags
export WLR_NO_HARDWARE_CURSORS=1
export WLR_RENDERER_ALLOW_SOFTWARE=1
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=sway
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM="wayland;xcb"

# 3. Launch Sway with --unsupported-gpu flag to bypass wlroots NVIDIA driver termination
exec sway --unsupported-gpu "$@"
