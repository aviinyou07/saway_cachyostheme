// Cyber Studio // fastfetch
// `logo.source` is set explicitly: the repo shipped a custom ASCII logo
// (cachyos_cyber.txt) that nothing ever referenced, so fastfetch always
// drew the stock CachyOS art instead.
// The art uses fastfetch's $1/$2 colour placeholders (NOT neofetch's
// ${c1}/${1} form, which fastfetch prints literally), bound below to
// accent #38BDF8 and ok #22C55E from ../PALETTE.md.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "localip",
    "battery",
    "locale",
    "break",
    "colors"
  ],
  "logo": {
    "source": "~/.config/fastfetch/cachyos_cyber.txt",
    "type": "file",
    "padding": {
      "top": 1,
      "right": 3
    },
    "color": {
      "1": "38;2;56;189;248",
      "2": "38;2;34;197;94"
    }
  },
  "display": {
    "separator": "  "
  }
}
